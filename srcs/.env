# Host port nginx binds to. Must be 443 on the actual VM (the subject
# requires port 443 specifically). On this Ubuntu PC, Pi-hole already
# uses 443 for its own admin panel, so use a different port for local testing.
NGINX_PORT=8443
# MYSQL SETUP
MYSQL_DATABASE=wordpress
MYSQL_USER=wp_user
# WORDPRESS SETUP
WP_TITLE=Inception
WP_ADMIN_USER=superuser
WP_ADMIN_EMAIL=superuser@ael-krai.42.fr
WP_USER=editor
WP_USER_EMAIL=editor@ael-krai.42.fr